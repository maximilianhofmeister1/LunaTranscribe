<Window x:Class="LunaTranscribe.UI.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LunaTranscribe Overlay"
        SizeToContent="WidthAndHeight"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" Focusable="False"
        FontFamily="Segoe UI">
    <Border x:Name="Capsule" Background="#E6202230" CornerRadius="22" Padding="16,9,10,9" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.35" />
        </Border.Effect>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <!-- Aufnahme -->
            <StackPanel x:Name="RecordingPanel" Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse x:Name="RecordDot" Width="10" Height="10" Fill="#FF453A" VerticalAlignment="Center" />
                <TextBlock Text="Aufnahme…" Foreground="White" FontSize="13" FontWeight="Medium" Margin="10,0,10,0" VerticalAlignment="Center" />
                <StackPanel x:Name="LevelMeter" Orientation="Horizontal" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Transkription -->
            <StackPanel x:Name="TranscribingPanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                <Grid Width="14" Height="14" VerticalAlignment="Center">
                    <Ellipse Stroke="#55FFFFFF" StrokeThickness="2" />
                    <Ellipse x:Name="Spinner" Stroke="White" StrokeThickness="2" StrokeDashArray="8 20" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <RotateTransform x:Name="SpinnerRotate" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                </Grid>
                <TextBlock x:Name="TranscribingLabel" Text="Transkribiere…" Foreground="White" FontSize="13" FontWeight="Medium" Margin="10,0,4,0" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Hinweis -->
            <StackPanel x:Name="NoticePanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="White" VerticalAlignment="Center" />
                <TextBlock x:Name="NoticeLabel" Foreground="White" FontSize="13" Margin="10,0,4,0" VerticalAlignment="Center"
                           MaxWidth="420" TextWrapping="Wrap" />
            </StackPanel>

            <!-- Abbrechen -->
            <Button x:Name="CloseButton" Click="Close_Click" ToolTip="Abbrechen (Esc)" Focusable="False" Margin="8,0,0,0"
                    Background="Transparent" BorderThickness="0" Padding="4" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#BBFFFFFF" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Border>
</Window>
