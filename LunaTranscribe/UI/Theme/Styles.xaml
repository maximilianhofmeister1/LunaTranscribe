<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:t="clr-namespace:LunaTranscribe.UI.Theme">

    <!-- Design-System „Mondnacht“: Schriften, Textstile, Bausteine. Farben setzt LunaTheme (DynamicResource „Luna.*“). -->

    <!-- MARK: Schriften (Fraunces/Figtree als statische Instanzen, siehe scripts/make-fonts.py) -->
    <FontFamily x:Key="Luna.Font.Display">pack://application:,,,/Assets/Fonts/#Luna Display</FontFamily>
    <FontFamily x:Key="Luna.Font.Title">pack://application:,,,/Assets/Fonts/#Luna Title</FontFamily>
    <FontFamily x:Key="Luna.Font.Text">pack://application:,,,/Assets/Fonts/#Luna Text</FontFamily>
    <FontFamily x:Key="Luna.Font.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- MARK: Textstile -->
    <Style x:Key="Luna.TextBase" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Luna.Font.Text}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Luna.Ink}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>
    <Style x:Key="Luna.Text" TargetType="TextBlock" BasedOn="{StaticResource Luna.TextBase}">
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Luna.TextMuted" TargetType="TextBlock" BasedOn="{StaticResource Luna.Text}">
        <Setter Property="Foreground" Value="{DynamicResource Luna.InkMuted}" />
    </Style>
    <Style x:Key="Luna.Caption" TargetType="TextBlock" BasedOn="{StaticResource Luna.TextBase}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Luna.InkMuted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Luna.Hint" TargetType="TextBlock" BasedOn="{StaticResource Luna.Caption}" />
    <Style x:Key="Luna.SmallCaps" TargetType="TextBlock" BasedOn="{StaticResource Luna.TextBase}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Luna.InkMuted}" />
        <Setter Property="Typography.Capitals" Value="AllSmallCaps" />
    </Style>
    <Style x:Key="Luna.Display" TargetType="TextBlock" BasedOn="{StaticResource Luna.TextBase}">
        <Setter Property="FontFamily" Value="{StaticResource Luna.Font.Display}" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Luna.Title" TargetType="TextBlock" BasedOn="{StaticResource Luna.TextBase}">
        <Setter Property="FontFamily" Value="{StaticResource Luna.Font.Title}" />
        <Setter Property="FontSize" Value="16" />
    </Style>

    <!-- MARK: Buttons (Kapsel; primär = Lavendel, sekundär = Oberfläche mit Haarlinie, leise = nur Lavendel-Text) -->
    <Style x:Key="Luna.ButtonBase" TargetType="ButtonBase">
        <Setter Property="FontFamily" Value="{StaticResource Luna.Font.Text}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource Luna.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Luna.Stroke}" />
        <Setter Property="Foreground" Value="{DynamicResource Luna.Ink}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={x:Static t:CapsuleRadiusConverter.Instance}}" />
                        <Border x:Name="Hover" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={x:Static t:CapsuleRadiusConverter.Instance}}" Background="{DynamicResource Luna.Ink}" Opacity="0" />
                        <StackPanel Orientation="Horizontal" Margin="{TemplateBinding Padding}"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center">
                            <t:LunaIcon x:Name="Icon" Kind="{TemplateBinding t:Luna.Icon}" Size="13" Margin="0,0,6,0"
                                        Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
                            <ContentPresenter x:Name="Content" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="t:Luna.Icon" Value="None">
                            <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="Icon" Property="Margin" Value="0" />
                            <Setter TargetName="Content" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hover" Property="Opacity" Value="0.06" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.75" />
                            <Setter TargetName="Root" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.97" ScaleY="0.97" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Luna.Secondary" TargetType="Button" BasedOn="{StaticResource Luna.ButtonBase}" />
    <Style TargetType="Button" BasedOn="{StaticResource Luna.Secondary}" />

    <Style x:Key="Luna.Primary" TargetType="Button" BasedOn="{StaticResource Luna.ButtonBase}">
        <Setter Property="Background" Value="{DynamicResource Luna.Lavender}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Luna.OnAccent}" />
    </Style>

    <Style x:Key="Luna.Quiet" TargetType="Button" BasedOn="{StaticResource Luna.ButtonBase}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Luna.Lavender}" />
        <Setter Property="Padding" Value="6,7" />
    </Style>

    <Style x:Key="Luna.Destructive" TargetType="Button" BasedOn="{StaticResource Luna.ButtonBase}">
        <Setter Property="Background" Value="{DynamicResource Luna.RoseSoft}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Luna.Rose}" />
    </Style>

    <!-- Auf dem Nachthimmel (Hero, Overlay): immer dunkle Variante -->
    <Style x:Key="Luna.HeroPrimary" TargetType="Button" BasedOn="{StaticResource Luna.ButtonBase}">
        <Setter Property="Background" Value="#B9A7F0" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="#1A1830" />
    </Style>
    <Style x:Key="Luna.HeroSecondary" TargetType="Button" BasedOn="{StaticResource Luna.ButtonBase}">
        <Setter Property="Background" Value="#26223F" />
        <Setter Property="BorderBrush" Value="#1FEDE6D6" />
        <Setter Property="Foreground" Value="#EDE6D6" />
    </Style>

    <!-- Kleine Variante für Listen und Warteschlange -->
    <Style x:Key="Luna.QuietSmall" TargetType="Button" BasedOn="{StaticResource Luna.Quiet}">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Padding" Value="4,3" />
    </Style>
    <Style x:Key="Luna.SecondarySmall" TargetType="Button" BasedOn="{StaticResource Luna.Secondary}">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Padding" Value="10,4" />
    </Style>

    <!-- Umschalter als Button (z. B. „Vertraulich“): leise, aktiv = Lavendel-Fläche -->
    <Style x:Key="Luna.ToggleQuiet" TargetType="ToggleButton" BasedOn="{StaticResource Luna.ButtonBase}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Luna.Lavender}" />
        <Setter Property="Padding" Value="8,5" />
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource Luna.LavenderSoft}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- MARK: Karte -->
    <Style TargetType="t:LunaCard">
        <Setter Property="Padding" Value="16" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="t:LunaCard">
                    <Grid>
                        <Border CornerRadius="16" Background="{DynamicResource Luna.Surface}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="2" Direction="270" Opacity="0.06" Color="Black" />
                            </Border.Effect>
                        </Border>
                        <Border CornerRadius="16" Background="{DynamicResource Luna.Surface}" BorderBrush="{DynamicResource Luna.Stroke}"
                                BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- MARK: Seitengerüst -->
    <Style TargetType="t:LunaPage">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="t:LunaPage">
                    <ScrollViewer x:Name="PART_Scroll" Background="{DynamicResource Luna.Background}" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <!-- Inhalt bis 820 px breit, links ausgerichtet (MaxWidth auf der Spalte, damit schmale Seiten trotzdem füllen) -->
                        <Grid Margin="28">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MaxWidth="820" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,20">
                                <ContentPresenter DockPanel.Dock="Right" Content="{TemplateBinding Accessory}" VerticalAlignment="Bottom" Margin="12,0,0,2" />
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Luna.Display}" Text="{TemplateBinding Title}" />
                                    <TextBlock x:Name="Sub" Style="{StaticResource Luna.TextMuted}" Text="{TemplateBinding Subtitle}" Margin="0,4,0,0" />
                                </StackPanel>
                            </DockPanel>
                            <ContentPresenter Grid.Row="1" />
                        </Grid>
                    </ScrollViewer>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Subtitle" Value="{x:Null}">
                            <Setter TargetName="Sub" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="t:SectionTitle">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="t:SectionTitle">
                    <StackPanel Orientation="Horizontal">
                        <t:LunaIcon x:Name="Icon" Kind="{TemplateBinding Icon}" Size="15" Foreground="{DynamicResource Luna.Lavender}"
                                    Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Style="{StaticResource Luna.Title}" Text="{TemplateBinding Title}" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Icon" Value="None">
                            <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="t:Chip">
        <Setter Property="Foreground" Value="{DynamicResource Luna.Lavender}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="t:Chip">
                    <Grid>
                        <Border CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={x:Static t:CapsuleRadiusConverter.Instance}}" Background="{TemplateBinding Foreground}" Opacity="0.13" />
                        <StackPanel Orientation="Horizontal" Margin="8,3">
                            <t:LunaIcon x:Name="Icon" Kind="{TemplateBinding Icon}" Size="11" Foreground="{TemplateBinding Foreground}"
                                        Margin="0,0,4,0" VerticalAlignment="Center" />
                            <TextBlock Text="{TemplateBinding Text}" FontFamily="{StaticResource Luna.Font.Text}" FontSize="11" FontWeight="Medium"
                                       Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Icon" Value="None">
                            <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="t:Keycap">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="t:Keycap">
                    <Border Background="{DynamicResource Luna.SurfaceMuted}" BorderBrush="{DynamicResource Luna.Stroke}" BorderThickness="1"
                            CornerRadius="6" Padding="8,3">
                        <TextBlock Text="{TemplateBinding Text}" FontFamily="{StaticResource Luna.Font.Text}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Luna.Ink}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="t:LearnMore">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="t:LearnMore">
                    <StackPanel>
                        <ToggleButton x:Name="Toggle" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                      Cursor="Hand" HorizontalAlignment="Left" FocusVisualStyle="{x:Null}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <StackPanel Orientation="Horizontal" Background="Transparent">
                                        <t:LunaIcon x:Name="Chevron" Kind="ChevronDown" Size="10" Foreground="{DynamicResource Luna.Lavender}"
                                                    VerticalAlignment="Center" Margin="0,1,5,0" />
                                        <TextBlock x:Name="Label" Text="Mehr erfahren" FontFamily="{StaticResource Luna.Font.Text}" FontSize="11.5"
                                                   FontWeight="Medium" Foreground="{DynamicResource Luna.Lavender}" />
                                    </StackPanel>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Chevron" Property="Kind" Value="ChevronUp" />
                                            <Setter TargetName="Label" Property="Text" Value="Weniger" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <TextBlock x:Name="Body" Text="{TemplateBinding Text}" Style="{StaticResource Luna.Caption}" Margin="0,6,0,0" Visibility="Collapsed" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="Body" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- MARK: Eingabefelder -->
    <Style TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource Luna.Font.Text}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Luna.Ink}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Luna.Ink}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Luna.Lavender}" />
        <Setter Property="Background" Value="{DynamicResource Luna.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Luna.Stroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                        <Grid Margin="{TemplateBinding Padding}">
                            <TextBlock x:Name="Placeholder" Text="{TemplateBinding t:Luna.Placeholder}" Foreground="{DynamicResource Luna.InkMuted}"
                                       FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" Margin="2,0,0,0"
                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}" IsHitTestVisible="False" Visibility="Collapsed" />
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Luna.Lavender}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Rahmenloses Feld (Titel im Meeting, Suche mit eigener Umrandung) -->
    <Style x:Key="Luna.PlainTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- Mehrzeiliger Editor (Prompts, Korrekturen) -->
    <Style x:Key="Luna.Editor" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Background" Value="{DynamicResource Luna.SurfaceMuted}" />
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="Padding" Value="8" />
    </Style>
    <Style x:Key="Luna.CodeEditor" TargetType="TextBox" BasedOn="{StaticResource Luna.Editor}">
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- MARK: Auswahl (Picker) -->
    <Style x:Key="Luna.ComboToggle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ClickMode" Value="Press" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="{DynamicResource Luna.Surface}" BorderBrush="{DynamicResource Luna.Stroke}" BorderThickness="1" CornerRadius="8">
                        <t:LunaIcon Kind="ChevronDown" Size="10" Foreground="{DynamicResource Luna.InkMuted}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Luna.SurfaceMuted}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource Luna.Font.Text}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Luna.Ink}" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="10,4,28,4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Style="{StaticResource Luna.ComboToggle}"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" IsHitTestVisible="False" VerticalAlignment="Center"
                                          Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />
                        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"
                               Focusable="False" PopupAnimation="Fade">
                            <Border Background="{DynamicResource Luna.Surface}" BorderBrush="{DynamicResource Luna.Stroke}" BorderThickness="1"
                                    CornerRadius="10" Padding="4" Margin="0,4,8,10" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.18" />
                                </Border.Effect>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Luna.Ink}" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <DockPanel>
                            <t:LunaIcon x:Name="Check" DockPanel.Dock="Left" Kind="Check" Size="11" Foreground="{DynamicResource Luna.Lavender}"
                                        Margin="0,0,8,0" Visibility="Hidden" VerticalAlignment="Center" />
                            <ContentPresenter VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Luna.LavenderSoft}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- MARK: Schalter -->
    <Style x:Key="Luna.Switch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Width="38" Height="22" Background="Transparent">
                        <Border x:Name="Track" CornerRadius="11" Background="{DynamicResource Luna.SurfaceMuted}"
                                BorderBrush="{DynamicResource Luna.Stroke}" BorderThickness="1" />
                        <Ellipse x:Name="Knob" Width="16" Height="16" HorizontalAlignment="Left" Margin="3,0,0,0" Fill="{DynamicResource Luna.InkMuted}">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="3" ShadowDepth="1" Direction="270" Opacity="0.2" />
                            </Ellipse.Effect>
                        </Ellipse>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Luna.Lavender}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="Transparent" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0" />
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource Luna.OnAccent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource Luna.Font.Text}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Luna.Ink}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="16" Height="16" CornerRadius="5" Background="{DynamicResource Luna.Surface}"
                                BorderBrush="{DynamicResource Luna.InkMuted}" BorderThickness="1.2" VerticalAlignment="Center">
                            <t:LunaIcon x:Name="Mark" Kind="Check" Size="10" Foreground="{DynamicResource Luna.OnAccent}" Visibility="Collapsed"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Luna.Lavender}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Luna.Lavender}" />
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource Luna.Font.Text}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Luna.Ink}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <DockPanel Background="Transparent">
                        <Grid DockPanel.Dock="Left" Width="16" Height="16" VerticalAlignment="Top" Margin="0,1,8,0">
                            <Ellipse x:Name="Ring" Stroke="{DynamicResource Luna.InkMuted}" StrokeThickness="1.2" Fill="{DynamicResource Luna.Surface}" />
                            <Ellipse x:Name="Dot" Width="7" Height="7" Fill="{DynamicResource Luna.OnAccent}" Visibility="Collapsed" />
                        </Grid>
                        <ContentPresenter VerticalAlignment="Center" />
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Ring" Property="Fill" Value="{DynamicResource Luna.Lavender}" />
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Luna.Lavender}" />
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Bereichs-Tabs der Einstellungen: aktiv = primärer Button, sonst leise -->
    <Style x:Key="Luna.Tab" TargetType="RadioButton" BasedOn="{StaticResource Luna.ButtonBase}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Luna.Lavender}" />
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource Luna.Lavender}" />
                <Setter Property="Foreground" Value="{DynamicResource Luna.OnAccent}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Segmentierte Auswahl (Transkript / Zusammenfassung) -->
    <Style x:Key="Luna.Segment" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource Luna.Font.Text}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource Luna.InkMuted}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" CornerRadius="7" Padding="14,5" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Luna.Surface}" />
                            <Setter Property="Foreground" Value="{DynamicResource Luna.Ink}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Seitenleisten-Eintrag -->
    <Style x:Key="Luna.SidebarItem" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource Luna.Font.Text}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Foreground" Value="{DynamicResource Luna.Ink}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Margin" Value="8,0,8,2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" CornerRadius="10" Padding="12,8" Background="Transparent">
                        <DockPanel>
                            <t:LunaIcon x:Name="Icon" DockPanel.Dock="Left" Kind="{TemplateBinding t:Luna.Icon}" Size="15" Width="20"
                                        Foreground="{DynamicResource Luna.InkMuted}" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <Border x:Name="Badge" DockPanel.Dock="Right" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={x:Static t:CapsuleRadiusConverter.Instance}}" Background="{DynamicResource Luna.Honey}" Padding="6,1"
                                    VerticalAlignment="Center" Visibility="Collapsed">
                                <TextBlock Text="{Binding (t:Luna.Badge), RelativeSource={RelativeSource TemplatedParent}}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource Luna.OnAccent}" />
                            </Border>
                            <ContentPresenter x:Name="Content" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Luna.SurfaceHover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Luna.Surface}" />
                            <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource Luna.Lavender}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <DataTrigger Binding="{Binding (t:Luna.Badge), RelativeSource={RelativeSource Self}, Converter={x:Static t:PositiveConverter.Instance}}" Value="True">
                            <Setter TargetName="Badge" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Liste: Zeile ohne Systemauswahl (Auswahl zeichnen die Seiten selbst) -->
    <Style x:Key="Luna.PlainListItem" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <ContentPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Aufklappbarer Bereich (DisclosureGroup) -->
    <Style TargetType="Expander">
        <Setter Property="Foreground" Value="{DynamicResource Luna.InkMuted}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <StackPanel>
                        <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                      Cursor="Hand" HorizontalAlignment="Left" FocusVisualStyle="{x:Null}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <StackPanel Orientation="Horizontal" Background="Transparent">
                                        <t:LunaIcon x:Name="Chevron" Kind="ChevronRight" Size="10" Foreground="{DynamicResource Luna.InkMuted}"
                                                    VerticalAlignment="Center" Margin="0,1,6,0" />
                                        <ContentPresenter Content="{Binding Header, RelativeSource={RelativeSource AncestorType=Expander}}" />
                                    </StackPanel>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Chevron" Property="Kind" Value="ChevronDown" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="Body" Visibility="Collapsed" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="Body" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- MARK: Fortschritt -->
    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="4" />
        <Setter Property="Foreground" Value="{DynamicResource Luna.Lavender}" />
        <Setter Property="Background" Value="{DynamicResource Luna.LavenderSoft}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" CornerRadius="2" Background="{TemplateBinding Background}" />
                        <Border x:Name="PART_Indicator" CornerRadius="2" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- MARK: Bildlaufleisten (schmal, unaufdringlich) -->
    <Style x:Key="Luna.ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bd" CornerRadius="3" Background="{DynamicResource Luna.InkMuted}" Opacity="0.35" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.6" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.7" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Luna.ScrollPage" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="2">
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Style="{StaticResource Luna.ScrollPage}" Command="ScrollBar.PageUpCommand" />
                        </Track.DecreaseRepeatButton>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Style="{StaticResource Luna.ScrollPage}" Command="ScrollBar.PageDownCommand" />
                        </Track.IncreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb Style="{StaticResource Luna.ScrollThumb}" />
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="10" />
                <Setter Property="MinHeight" Value="10" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track" Margin="2">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource Luna.ScrollPage}" Command="ScrollBar.PageLeftCommand" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource Luna.ScrollPage}" Command="ScrollBar.PageRightCommand" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource Luna.ScrollThumb}" />
                                </Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- MARK: Menüs, Tooltips, Trenner -->
    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource Luna.Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource Luna.Ink}" />
        <Setter Property="FontFamily" Value="{StaticResource Luna.Font.Text}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Luna.Stroke}" BorderThickness="1"
                            CornerRadius="10" Padding="4" Margin="0,2,8,10">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.18" />
                        </Border.Effect>
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource Luna.Ink}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd" CornerRadius="6" Padding="10,6" Background="Transparent">
                        <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Luna.LavenderSoft}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Background="{DynamicResource Luna.Stroke}" Margin="0,4" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource Luna.Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource Luna.Ink}" />
        <Setter Property="FontFamily" Value="{StaticResource Luna.Font.Text}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Luna.Stroke}" BorderThickness="1"
                            CornerRadius="8" Padding="9,6" Margin="0,0,6,8" MaxWidth="360">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.15" />
                        </Border.Effect>
                        <ContentPresenter>
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
