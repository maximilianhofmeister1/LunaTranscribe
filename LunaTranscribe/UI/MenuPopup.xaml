<Window x:Class="LunaTranscribe.UI.MenuPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LunaTranscribe"
        Width="320" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="True"
        FontFamily="Segoe UI" FontSize="12.5">
    <Border Background="White" BorderBrush="#D6D6DC" BorderThickness="1" CornerRadius="8" Padding="12" Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.18" />
        </Border.Effect>
        <StackPanel>
            <!-- Statuszeile -->
            <DockPanel Margin="0,0,0,8">
                <Ellipse x:Name="StatusDot" Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{StaticResource OkBrush}" />
                <TextBlock x:Name="StatusLabel" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>

            <!-- Warnung: Mikrofon-Datenschutz -->
            <Border x:Name="MicWarning" Background="#FFF6E5" BorderBrush="#F1D8A5" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Foreground="{StaticResource WarnBrush}" Text="Mikrofonzugriff deaktiviert" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,6"
                               Text="Windows blockiert den Mikrofonzugriff für Desktop-Apps. Ohne ihn kann nichts aufgenommen werden." />
                    <Button Content="Einstellungen öffnen…" HorizontalAlignment="Left" Click="OpenMicSettings_Click" />
                </StackPanel>
            </Border>

            <Separator Margin="0,0,0,8" />

            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Sprache" VerticalAlignment="Center" Margin="0,0,10,4" />
                <ComboBox Grid.Row="0" Grid.Column="1" x:Name="LanguageBox" Margin="0,0,0,4" SelectionChanged="LanguageBox_SelectionChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource LanguageName}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Engine" VerticalAlignment="Center" Margin="0,0,10,0" />
                <ComboBox Grid.Row="1" Grid.Column="1" x:Name="EngineBox" SelectionChanged="EngineBox_SelectionChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource EngineShortLabel}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <Button x:Name="ToggleButton" Style="{StaticResource PrimaryButton}" Content="Aufnahme starten" Click="Toggle_Click" />
                <Button x:Name="CancelButton" Content="Abbrechen (Esc)" Margin="8,0,0,0" Click="Cancel_Click" Visibility="Collapsed" />
            </StackPanel>

            <!-- Letzte Diktate -->
            <StackPanel x:Name="HistoryPanel" Visibility="Collapsed">
                <Separator Margin="0,10,0,8" />
                <DockPanel Margin="0,0,0,4">
                    <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Löschen" Click="ClearHistory_Click" />
                    <TextBlock Text="Letzte Diktate" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" />
                </DockPanel>
                <ItemsControl x:Name="HistoryList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource LinkButton}" Click="HistoryItem_Click" Tag="{Binding}"
                                    ToolTip="Klicken kopiert den Text in die Zwischenablage" HorizontalContentAlignment="Stretch">
                                <DockPanel Margin="0,2">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding ProcessingLabel}" FontSize="10" Foreground="{StaticResource TertiaryTextBrush}" Margin="8,0,0,0" />
                                    <TextBlock Text="{Binding Text}" FontSize="11" Foreground="#2A2A2A" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <Separator Margin="0,10,0,8" />

            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Beenden" Click="Quit_Click" />
                <Button Content="Einstellungen…" HorizontalAlignment="Left" Click="Settings_Click" />
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
