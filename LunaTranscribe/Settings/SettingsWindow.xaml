<Window x:Class="LunaTranscribe.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LunaTranscribe.Settings"
        Title="LunaTranscribe – Einstellungen"
        Width="560" Height="760" MinWidth="480" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="#F3F3F5" FontFamily="Segoe UI" FontSize="12.5">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,16">

            <!-- Allgemein -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="Allgemein" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <CheckBox x:Name="LaunchAtLogin" Content="Beim Anmelden automatisch starten" Checked="LaunchAtLogin_Changed" Unchecked="LaunchAtLogin_Changed" />
                    <TextBlock x:Name="LaunchAtLoginError" Style="{StaticResource Caption}" Foreground="{StaticResource RecordingBrush}" Visibility="Collapsed" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                               Text="Eintrag unter Einstellungen → Apps → Autostart. Zeigt auf den aktuellen Speicherort der EXE – nach dem Verschieben einmal aus- und wieder einschalten." />
                </StackPanel>
            </Border>

            <!-- Tastenkürzel -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="Tastenkürzel" />
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Diktieren (Hauptsprache):" VerticalAlignment="Center" Margin="0,0,12,6" />
                    <local:HotkeyRecorder Grid.Row="0" Grid.Column="1" x:Name="PrimaryRecorder" AllowEmpty="False" Margin="0,0,0,6" HorizontalAlignment="Left" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Hauptsprache" VerticalAlignment="Center" Margin="0,0,12,10" />
                    <ComboBox Grid.Row="1" Grid.Column="1" x:Name="PrimaryLanguage" Margin="0,0,0,10" HorizontalAlignment="Left" MinWidth="200" SelectionChanged="PrimaryLanguage_Changed">
                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource LanguageName}}" /></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Diktieren (Zweitsprache):" VerticalAlignment="Center" Margin="0,0,12,6" />
                    <local:HotkeyRecorder Grid.Row="2" Grid.Column="1" x:Name="SecondaryRecorder" Margin="0,0,0,6" HorizontalAlignment="Left" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Zweitsprache" VerticalAlignment="Center" Margin="0,0,12,10" />
                    <ComboBox Grid.Row="3" Grid.Column="1" x:Name="SecondaryLanguage" Margin="0,0,0,10" HorizontalAlignment="Left" MinWidth="200" SelectionChanged="SecondaryLanguage_Changed">
                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource LanguageName}}" /></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Verhalten" VerticalAlignment="Top" Margin="0,3,12,0" />
                    <StackPanel Grid.Row="4" Grid.Column="1">
                        <RadioButton x:Name="ModeHold" Content="Gedrückt halten" Checked="Mode_Changed" />
                        <RadioButton x:Name="ModeToggle" Content="Ein/Aus umschalten" Checked="Mode_Changed" />
                    </StackPanel>

                    <TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource Caption}" Margin="0,8,0,0"
                               Text="Der Hotkey wird von LunaTranscribe abgefangen und nicht an das aktive Programm weitergereicht (F2 löst also z. B. in Excel nicht mehr „Zelle bearbeiten“ aus). Die Sprachauswahl wirkt bei Cohere Transcribe; Parakeet erkennt die Sprache automatisch." />
                </Grid>
            </Border>

            <!-- Audio -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="Audio" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Left" Text="Mikrofon" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Button DockPanel.Dock="Right" Content="Geräte aktualisieren" Margin="8,0,0,0" Click="RefreshDevices_Click" />
                        <ComboBox x:Name="DeviceBox" DisplayMemberPath="Name" SelectionChanged="DeviceBox_Changed" />
                    </DockPanel>
                    <CheckBox x:Name="PlaySounds" Content="Töne bei Start/Stopp" Checked="Toggle_Changed" Unchecked="Toggle_Changed" />
                    <CheckBox x:Name="PauseMedia" Content="Wiedergabe (Musik, Videos) während der Aufnahme pausieren" Checked="Toggle_Changed" Unchecked="Toggle_Changed" />
                </StackPanel>
            </Border>

            <!-- Modell -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="Modell" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <RadioButton x:Name="EngineParakeet" Checked="Engine_Changed"><TextBlock x:Name="EngineParakeetLabel" TextWrapping="Wrap" /></RadioButton>
                    <RadioButton x:Name="EngineCohere" Checked="Engine_Changed"><TextBlock x:Name="EngineCohereLabel" TextWrapping="Wrap" /></RadioButton>
                    <Grid Margin="0,8,0,4">
                        <StackPanel x:Name="ModelLoading" Orientation="Horizontal">
                            <ProgressBar x:Name="ModelProgress" Width="180" Height="8" Minimum="0" Maximum="1" VerticalAlignment="Center" />
                            <TextBlock x:Name="ModelLoadingText" Style="{StaticResource Caption}" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel x:Name="ModelReady" Orientation="Horizontal" Visibility="Collapsed">
                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource OkBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="ModelReadyText" Margin="6,0,0,0" Foreground="{StaticResource OkBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel x:Name="ModelFailed" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xEA39;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource RecordingBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="ModelFailedText" Margin="6,0,0,0" Foreground="{StaticResource RecordingBrush}" TextWrapping="Wrap" MaxWidth="440" />
                            </StackPanel>
                            <Button Content="Erneut versuchen" HorizontalAlignment="Left" Margin="0,6,0,0" Click="RetryModel_Click" />
                        </StackPanel>
                        <TextBlock x:Name="ModelIdle" Text="Kein Modell geladen" Visibility="Collapsed" />
                    </Grid>
                    <DockPanel Margin="0,8,0,0">
                        <TextBlock Text="Modell nach Inaktivität entladen" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <ComboBox x:Name="UnloadAfterBox" HorizontalAlignment="Left" MinWidth="130" DisplayMemberPath="Label" SelectionChanged="UnloadAfter_Changed" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                               Text="Entladen gibt ~700 MB RAM frei. Beim nächsten Hotkey startet die Aufnahme sofort, das Modell lädt parallel (wenige Sekunden) – nur sehr kurze Diktate warten dann etwas länger auf den Text." />
                    <TextBlock x:Name="ModelPathText" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                    <Button Content="Modellordner öffnen" HorizontalAlignment="Left" Margin="0,6,0,0" Click="OpenModelFolder_Click" />
                </StackPanel>
            </Border>

            <!-- Datenschutz -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="Datenschutz" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <CheckBox x:Name="KeepHistory" Content="Letzte Diktate im Menü anzeigen (nur im RAM, nie gespeichert)" Checked="Toggle_Changed" Unchecked="Toggle_Changed" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                               Text="Aufnahmen bleiben ausschließlich im Arbeitsspeicher und werden direkt nach der Transkription verworfen. Es werden keine Daten an Server gesendet – die einzige Netzwerkverbindung ist der einmalige Modell-Download." />
                </StackPanel>
            </Border>

            <!-- Berechtigungen -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="Berechtigungen" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel>
                        <TextBlock Text="Mikrofon (Windows-Datenschutz)" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Button DockPanel.Dock="Right" x:Name="OpenMicButton" Content="Öffnen…" Click="OpenMic_Click" />
                        <TextBlock x:Name="MicStatus" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                               Text="Eine Bedienungshilfen-Berechtigung wie auf macOS gibt es unter Windows nicht. Einzige Ausnahme: In Programme, die als Administrator laufen, kann nur eingefügt werden, wenn LunaTranscribe ebenfalls als Administrator läuft." />
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,4,0,8" x:Name="VersionLabel" />
        </StackPanel>
    </ScrollViewer>
</Window>
