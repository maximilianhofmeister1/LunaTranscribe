<Window x:Class="LunaTranscribe.UI.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:t="clr-namespace:LunaTranscribe.UI.Theme"
        Title="LunaTranscribe Overlay"
        SizeToContent="WidthAndHeight"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" Focusable="False"
        FontFamily="{StaticResource Luna.Font.Text}" TextOptions.TextFormattingMode="Ideal">
    <!-- Die Pille: Nachthimmel-Verlauf, Mondsymbol, Status, Abbrechen-Knopf (wie OverlayView in Swift). -->
    <Grid Margin="16">
        <Border CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={x:Static t:CapsuleRadiusConverter.Instance}}" Background="{DynamicResource Luna.NightVertical}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.35" />
            </Border.Effect>
        </Border>
        <Border CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={x:Static t:CapsuleRadiusConverter.Instance}}" Background="{DynamicResource Luna.NightVertical}" BorderBrush="#1FFFFFFF" BorderThickness="1"
                Padding="12,9,10,9">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Aufnahme: Mond + lebendige Wellenform in Honig -->
                <StackPanel x:Name="RecordingIndicator" Orientation="Horizontal" VerticalAlignment="Center">
                    <t:LunaIcon Kind="Moon" Size="16" Foreground="{DynamicResource Luna.HoneyNight}" VerticalAlignment="Center" />
                    <t:WaveformView x:Name="Waveform" BarBrush="{DynamicResource Luna.HoneyNight}" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <!-- Transkription: pulsierender Mond mit Sternen -->
                <t:LunaIcon x:Name="TranscribingIndicator" Kind="MoonStars" Size="17" Foreground="{DynamicResource Luna.Moonlight}" VerticalAlignment="Center" />
                <!-- Nachbearbeitung: funkelnde Sterne in Lavendel -->
                <t:LunaIcon x:Name="RefiningIndicator" Kind="Sparkles" Size="17" Foreground="{DynamicResource Luna.LavenderNight}" VerticalAlignment="Center" />
                <!-- Hinweis: gedämpfter Mond -->
                <t:LunaIcon x:Name="NoticeIndicator" Kind="Moon" Size="16" Foreground="{DynamicResource Luna.Moonlight}" Opacity="0.8" VerticalAlignment="Center" />

                <TextBlock x:Name="Label" Foreground="{DynamicResource Luna.Moonlight}" FontSize="13" FontWeight="Medium"
                           Margin="10,0,10,0" VerticalAlignment="Center" MaxWidth="320" TextWrapping="Wrap" />

                <Button x:Name="CloseButton" Click="Close_Click" ToolTip="Abbrechen (Esc)" Focusable="False" Cursor="Hand" VerticalAlignment="Center">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid Width="20" Height="20">
                                <Ellipse x:Name="Bg" Fill="#1AFFFFFF" />
                                <t:LunaIcon Kind="Close" Size="9" Foreground="#B3FBF1DC" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Fill" Value="#33FFFFFF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
