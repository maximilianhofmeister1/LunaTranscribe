<UserControl x:Class="LunaTranscribe.UI.Pages.OverviewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:LunaTranscribe.UI.Theme">
    <!-- Startseite: Begrüßung, heutige Zahlen, Status der Modelle, Tastenkürzel, letzte Meetings. -->
    <t:LunaPage x:Name="Page" Subtitle="Sprich einfach los – alles bleibt auf diesem PC.">
        <t:VStack Spacing="20">

            <!-- Nachthimmel-Kachel mit den zwei Hauptaktionen -->
            <Border CornerRadius="20" Background="{DynamicResource Luna.NightDiagonal}" Padding="22">
                <DockPanel>
                    <Grid DockPanel.Dock="Right" Width="76" Height="76" Margin="20,0,12,0" VerticalAlignment="Center">
                        <Grid.Effect>
                            <DropShadowEffect Color="#E8B04B" BlurRadius="40" ShadowDepth="0" Opacity="0.55" />
                        </Grid.Effect>
                        <Path x:Name="HeroMoon" Fill="{DynamicResource Luna.Moonlight}" Stretch="None" />
                        <Path x:Name="HeroStars" Fill="{DynamicResource Luna.HoneyNight}" Stretch="None" />
                    </Grid>
                    <StackPanel>
                        <TextBlock x:Name="HeroTitle" FontFamily="{StaticResource Luna.Font.Display}" FontSize="22" Foreground="{DynamicResource Luna.Moonlight}"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="HeroText" FontSize="13" Foreground="{DynamicResource Luna.Moonlight}" Opacity="0.75" TextWrapping="Wrap" Margin="0,8,0,0" />
                        <t:HStack Spacing="10" Margin="0,12,0,0">
                            <Button x:Name="DictateButton" Style="{StaticResource Luna.HeroPrimary}" t:Luna.Icon="Mic" Click="Dictate_Click" />
                            <Button x:Name="MeetingButton" Style="{StaticResource Luna.HeroSecondary}" t:Luna.Icon="People" Click="Meeting_Click" />
                        </t:HStack>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Zahlen -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <t:LunaCard Grid.Column="0">
                    <t:VStack Spacing="6">
                        <t:LunaIcon Kind="TextLines" Size="15" Foreground="{DynamicResource Luna.Lavender}" HorizontalAlignment="Left" />
                        <TextBlock x:Name="WordsValue" Style="{StaticResource Luna.Display}" FontSize="28" />
                        <TextBlock Style="{StaticResource Luna.Caption}" Text="Wörter heute diktiert" />
                    </t:VStack>
                </t:LunaCard>
                <t:LunaCard Grid.Column="2">
                    <t:VStack Spacing="6">
                        <t:LunaIcon Kind="Waveform" Size="15" Foreground="{DynamicResource Luna.Lavender}" HorizontalAlignment="Left" />
                        <TextBlock x:Name="DictationsValue" Style="{StaticResource Luna.Display}" FontSize="28" />
                        <TextBlock Style="{StaticResource Luna.Caption}" Text="Diktate heute" />
                    </t:VStack>
                </t:LunaCard>
                <t:LunaCard Grid.Column="4">
                    <t:VStack Spacing="6">
                        <t:LunaIcon Kind="People" Size="15" Foreground="{DynamicResource Luna.Lavender}" HorizontalAlignment="Left" />
                        <TextBlock x:Name="MeetingsValue" Style="{StaticResource Luna.Display}" FontSize="28" />
                        <TextBlock Style="{StaticResource Luna.Caption}" Text="Meetings gespeichert" />
                    </t:VStack>
                </t:LunaCard>
            </Grid>

            <!-- Modelle + Tastenkürzel -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <t:LunaCard Grid.Column="0" VerticalAlignment="Stretch">
                    <t:VStack x:Name="ModelsCard" Spacing="10">
                        <t:SectionTitle Title="Modelle" Icon="Cpu" />
                    </t:VStack>
                </t:LunaCard>
                <t:LunaCard Grid.Column="2" VerticalAlignment="Stretch">
                    <t:VStack x:Name="ShortcutsCard" Spacing="10">
                        <t:SectionTitle Title="Tastenkürzel" Icon="Keyboard" />
                    </t:VStack>
                </t:LunaCard>
            </Grid>

            <!-- Letzte Meetings -->
            <t:LunaCard>
                <t:VStack Spacing="10">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Luna.Quiet}" Content="Alle anzeigen" Click="AllMeetings_Click" />
                        <t:SectionTitle Title="Letzte Meetings" Icon="People" VerticalAlignment="Center" />
                    </DockPanel>
                    <t:VStack x:Name="RecentMeetings" Spacing="4" />
                </t:VStack>
            </t:LunaCard>
        </t:VStack>
    </t:LunaPage>
</UserControl>
